# Copy to .env and fill in. Never commit .env.

# Required. Get one from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here

# Shared key callers must present to POST /diagnose, as either
#   X-API-Key: <key>        or    Authorization: Bearer <key>
# Leave blank to disable auth entirely — acceptable on localhost, never when
# the port is reachable from a network. /healthz reports which mode is active.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_API_KEY=

# Vector store. Leave QDRANT_URL blank to run Qdrant embedded on local disk
# (no Docker needed). Set it to switch — no code changes either way:
#   http://localhost:6333                  -> docker run -p 6333:6333 qdrant/qdrant
#   https://xxx.cloud.qdrant.io:6333       -> Qdrant Cloud
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_PATH=./qdrant_data
QDRANT_COLLECTION=runbooks

# Model IDs. Kept here because Gemini model strings change often and a wrong
# one is the most common first-day error.
EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768
JUDGE_MODEL=gemini-3.1-flash-lite
SYNTH_MODEL=gemini-3.8-flash

# Tried in order when the preferred model returns 503 (capacity) or 429 (rate
# limit). Flash capacity is genuinely flaky — roughly one call in three during
# development — so without this the demo crashes at random.
FALLBACK_MODELS=gemini-3.7-flash,gemini-3.1-flash-lite

# A floor, not a relevance classifier. Below this the chunk is obvious garbage and
# the judge call is skipped. Above it, the judge decides whether the excerpt actually
# covers the incident (covers_incident), because cosine cannot: measured, on-topic
# scores run 0.5602-0.7706 and off-topic 0.5621-0.6648, which overlap. Keep this
# below the lowest on-topic score or you reject queries the runbook does cover.
# Re-derived at 0.52 once the score began describing the chunk actually served
# rather than dense retrieval's top hit: chunk-level scores run lower.
MIN_MATCH_SCORE=0.52

# Hybrid retrieval: dense embedding and BM25 both searched, then fused (DBSF).
# BM25 catches exact tokens that embedding blurs — `wal_keep_segments`, `recovery.conf`
# — which is what the staleness audit reasons about. Set to false for dense only.
# Changing this requires re-running `python -m copilot.ingest`: Qdrant cannot add or
# drop a sparse vector on an existing collection, so ingest recreates it.
HYBRID_SEARCH=true

# One web search per stale finding the judge reports, capped here. Findings past
# the cap still reach the answer, corrected from model knowledge and tagged
# [unverified] rather than silently dropped.
MAX_SEARCHES=3

# Sized so each runbook stays ONE chunk — the corpus runs 2720-3431 chars per
# file. Below ~3500 every .md runbook splits into fragments like a bare Prevention
# section, which names no symptom and so retrieves for the wrong incident. Raise
# it if a runbook grows; do not lower it to force finer chunks.
MAX_CHUNK_CHARS=3600

# Where ingest reads from. Both .txt and .md are picked up.
RUNBOOK_DIR=./runbooks
