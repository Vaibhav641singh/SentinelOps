# Copy to .env and fill in. Never commit .env.

# Required. Get one from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here

# Shared key callers must present to POST /diagnose, as either
#   X-API-Key: <key>        or    Authorization: Bearer <key>
# Leave blank to disable auth entirely — acceptable on localhost, never when
# the port is reachable from a network. /healthz reports which mode is active.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_API_KEY=

# Vector store. Leave QDRANT_URL blank to run Qdrant embedded on local disk
# (no Docker needed). Set it to switch — no code changes either way:
#   http://localhost:6333                  -> docker run -p 6333:6333 qdrant/qdrant
#   https://xxx.cloud.qdrant.io:6333       -> Qdrant Cloud
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_PATH=./qdrant_data
QDRANT_COLLECTION=runbooks

# Model IDs. Kept here because Gemini model strings change often and a wrong
# one is the most common first-day error.
EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768
JUDGE_MODEL=gemini-3.1-flash-lite
SYNTH_MODEL=gemini-3.8-flash

# Cosine score below which the retrieved chunk counts as "nothing matched", so the
# staleness audit and web search are skipped. On-topic logs score ~0.74-0.78 here;
# an unrelated nginx error scored 0.55.
MIN_MATCH_SCORE=0.62
